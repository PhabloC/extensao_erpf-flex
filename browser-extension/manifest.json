{
  "manifest_version": 3,
  "name": "ERP Flex para Kanban Importer",
  "version": "0.1.0",
  "description": "Importa ordens de producao do ERP Flex para o kanban do sistema.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Importar Ordem do ERP Flex"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
