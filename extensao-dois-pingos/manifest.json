{
  "manifest_version": 3,
  "name": "ERP Flex para Kanban Importer",
  "version": "3.0.0",
  "description": "Importa ordens de produção do ERP Flex para o kanban do sistema.",
  "icons": {
    "16": "assets/icons/logo-16.png",
    "32": "assets/icons/logo-32.png",
    "48": "assets/icons/logo-48.png",
    "128": "assets/icons/logo-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Importar Ordem do ERP Flex",
    "default_icon": {
      "16": "assets/icons/logo-16.png",
      "32": "assets/icons/logo-32.png",
      "48": "assets/icons/logo-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.doispingos.com.br/*",
    "http://localhost/*"
  ]
}
